# Supabase project configuration
SUPABASE_URL=https://vupqpfghoojeqvwzxtef.supabase.co
SUPABASE_REST_URL=https://vupqpfghoojeqvwzxtef.supabase.co/rest/v1/
# Keep all keys private and provide them through the backend host environment.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=public-assets

# Supabase Postgres pooler connection used by Prisma.
# Use the password and connection mode provided by Supabase; do not commit it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Frontend/backend deployment settings
ALLOWED_ORIGINS=http://localhost:4200
